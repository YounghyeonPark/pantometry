/target
node_modules/
*.log
.DS_Store

# The bindings are their own cargo workspace, so their build directory is not the root one.
/bindings/python/target
# maturin's output, and what a local `pip install -e` leaves behind.
/bindings/python/dist
__pycache__/
*.pyd
*.so

# Anything a run produces. The scenes README says nothing generated is committed, and saying it
# was not enough: an `add -A` put a 302 KB filmstrip and a 927 KB frame dump into history.
# Assets belong beside the scene that made them, in the working tree, and nowhere else.
/*.svg
/*.html
/*.csv
/world.json
/orbits*.json
/atoms*.json

# The app's build output. Its workspace is excluded from the root one, so the anchored `/target`
# rule above does not reach it — and neither did the three `/runtime/*/target/` lines this
# replaces, the moment those directories became `app/`. Unanchored, because this workspace has
# nested packages and each can grow one: `git add -A` spent two minutes walking a build directory
# before anybody noticed the rule had stopped matching anything.
target/
/app/site/*.wasm
